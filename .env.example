# ==============================================================================
# 🎵 Spotify Developer Credentials (Required for Spotify Presence & Top Tracks)
# ==============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# ==============================================================================
# 🤖 Multi-Provider LLM Quote Generator (Optional)
# Hỗ trợ: Google Gemini, Groq, Anthropic Claude, OpenAI, DeepSeek, OpenRouter
# (Nếu không cấu hình, API tự động dùng kho danh mục offline fallback)
# ==============================================================================

# Cách 1: Cấu hình theo Provider cụ thể (hệ thống tự nhận diện):
# 1. Google Gemini (Khuyên dùng - Miễn phí tại Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key

# 2. Groq (Tốc độ siêu nhanh ~500ms, Miễn phí Llama 3.3)
# GROQ_API_KEY=your_groq_api_key

# 3. Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key

# 4. OpenAI (ChatGPT)
# OPENAI_API_KEY=your_openai_api_key

# Cách 2: Cấu hình chung linh hoạt (hỗ trợ cả DeepSeek, OpenRouter, v.v.):
# LLM_PROVIDER=gemini # hoặc: groq, claude, openai
# LLM_API_KEY=your_api_key
# LLM_MODEL=gemini-2.0-flash # hoặc: llama-3.3-70b-versatile, claude-3-5-haiku-20241022, gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
